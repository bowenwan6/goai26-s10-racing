Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Ground Grid
      Alpha: 0.5
      Cell Size: 1
      Color: 100; 100; 100
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Front Airy (.201)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rslidar_front/points
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 0; 255; 80
      Alpha: 1
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Selectable: true
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Rear Airy (.202)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rslidar_rear/points
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 80; 40
      Alpha: 1
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Selectable: true
      Use Fixed Frame: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: lidar_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.55
      Yaw: 0.8
      Target Frame: lidar_link
      Name: Current View
Window Geometry:
  Height: 900
  Width: 1440
