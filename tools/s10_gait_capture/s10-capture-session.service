[Unit]
Description=S10 independent read-only data capture
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ysc
WorkingDirectory=/home/ysc/s10_capture_session
ExecStart=/bin/bash /home/ysc/s10_capture_session/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
