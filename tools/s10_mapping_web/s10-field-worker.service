[Unit]
Description=S10 offline phone field evidence worker (no motion control)
After=local-fs.target network.target
RequiresMountsFor=/var/opt/robot/data

[Service]
Type=simple
User=user
Group=user
UMask=0077
WorkingDirectory=/home/user/s10_mapping_web
ExecStartPre=/usr/bin/test -d /var/opt/robot/data/s10_field_assistant
ExecStartPre=/usr/bin/test -w /var/opt/robot/data/s10_field_assistant
ExecStart=/bin/bash /home/user/s10_mapping_web/field-worker.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=25
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
