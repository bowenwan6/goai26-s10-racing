# Perception-control fusion display.
#
# Shows what the follower actually steers on, in the frames it actually reads them in:
# the full lidar fan as scattered points, the horizontal ring the obstacle planner uses,
# and the body-frame height map that gates forward speed. Requires the `viz` node for TF
# and the point clouds -- launch with `race.launch.py rviz:=true`.
#
# Fixed frame is `world`, so the robot drives through a stationary scene and the sensor
# clouds sweep with it. Setting it to `base_link` instead pins the robot and makes the
# terrain move, which reads better when inspecting a single wedge.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Lidar fan1
        - /Height map1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 90; 90; 90
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: true
      Marker Scale: 0.6
      Show Arrows: false
      Show Axes: true
      Show Names: true

    # The full 64x8 fan. Coloured by height so a kerb separates visibly from the floor.
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar fan
      Enabled: true
      Topic:
        Value: /perception/lidar_points
        Depth: 5
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Decay Time: 0

    # The single row the obstacle planner steers on. Drawn separately and in red because
    # the fan makes it look like the planner sees far more than it does: it is one ring at
    # +2.1 degrees, and it tilts with the body -- nose-down on a ledge it points at the
    # floor, and the planner then swerves around ground returns.
    - Class: rviz_default_plugins/LaserScan
      Name: Planner ring
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Reliable
      Style: Spheres
      Size (m): 0.08
      Color: 255; 40; 40
      Color Transformer: FlatColor
      Decay Time: 0

    # 13x9 cells under and ahead of the robot, in the yaw-aligned frame they are sampled
    # in. This is what gates forward speed on terrain the ring cannot see.
    - Class: rviz_default_plugins/PointCloud2
      Name: Height map
      Enabled: true
      Topic:
        Value: /perception/heightmap_points
        Depth: 5
        Reliability Policy: Reliable
      Style: Boxes
      Size (m): 0.12
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Decay Time: 0

    - Class: rviz_default_plugins/Odometry
      Name: Base pose
      Enabled: true
      Topic:
        Value: /ground_truth/odom
        Depth: 5
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Arrow
        Shaft Length: 0.4
        Shaft Radius: 0.05
        Head Length: 0.15
        Head Radius: 0.1
        Color: 60; 200; 255

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 0.55
      Yaw: 1.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: base_link
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
