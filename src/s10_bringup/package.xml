<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>s10_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and tuned configuration for a full S10 racing run: simulator with
    perception, locomotion policy, and autonomous waypoint following.
  </description>
  <maintainer email="wang.bowen@icloud.com">s10-perception-racing contributors</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>s10_perception</exec_depend>
  <exec_depend>s10_auto_nav</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
