+def web_cfg():
+    """Navigation team's knobs for the web entry (ros1_gateway/config/web_nav.json), read at every use:
+    speed = forward speed handed to nav_session.sh arm (m/s, or '0.7x' of the robot maximum);
+    climb_speed = the same for stairs-gait stretches ('' = nav.yaml); allow_stairs = also offer routes with
+    stairs-gait zones (navigation runs them with zone_mode gait_only: same follower, gait switched by arc length)."""
+    cfg = dict(speed='0.3', climb_speed='', allow_stairs=False)
+    base = Path.home() / 'ros1_gateway' / 'config'
+    try:                                                   # THE parameter file (section web); web_nav.json is generated from it
+        import yaml
+        cfg.update({k: v for k, v in (yaml.safe_load((base / 's10_params.yaml').read_text()) or {}).get('web', {}).items() if k in cfg})
+    except Exception:
+        try:
+            cfg.update({k: v for k, v in json.loads((base / 'web_nav.json').read_text()).items() if k in cfg})
+        except (OSError, ValueError):
+            pass
+    cfg['speed'] = str(cfg['speed'])
+    return cfg
