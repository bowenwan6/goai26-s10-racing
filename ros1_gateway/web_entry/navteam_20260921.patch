+def parse_route(value):
+    """'<route id>@from=WP08@speed=1.0@climb=0.7' -> (id, options). Options are optional; the page builds the string."""
+    if not isinstance(value, str):
+        return value, {}
+    rid, *rest = value.split('@')
+    opts = {}
+    for item in rest:
+        k, _, v = item.partition('=')
+        if k == 'from' and re.fullmatch(r'WP\d{1,3}', v.upper()):
+            opts['from'] = v.upper()
+        elif k in ('speed', 'climb') and re.fullmatch(r'\d(\.\d{1,2})?', v):
+            lim = (0.1, 1.67)
+            if not lim[0] <= float(v) <= lim[1]:
+                raise ValueError(f'{k} 超出范围 {lim[0]}–{lim[1]} m/s')
+            opts[k] = v
+    return rid, opts
+
