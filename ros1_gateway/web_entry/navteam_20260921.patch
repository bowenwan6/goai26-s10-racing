+def web_cfg():
+    """Navigation team's knobs for the web entry (ros1_gateway/config/web_nav.json), read at every use:
+    speed = forward speed handed to nav_session.sh arm (m/s, or '0.7x' of the robot maximum);
+    climb_speed = the same for stairs-gait stretches ('' = nav.yaml); allow_stairs = also offer routes with
+    stairs-gait zones (navigation runs them with zone_mode gait_only: same follower, gait switched by arc length)."""
