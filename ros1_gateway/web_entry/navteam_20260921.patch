+def shift_maneuvers(doc, shift):
+    """maneuvers.json for a route that lost `shift` metres at its start; zones wholly behind the robot are dropped."""
+    out = copy.deepcopy(doc)
+    kept = []
+    for m in out.get('maneuvers', []):
+        if m['s1'] - shift <= 0.5:
+            continue
+        for key in ('s0', 's1', 's_first', 's_last'):
+            if m.get(key) is not None:
+                m[key] = max(0.0, m[key] - shift)
+        if m.get('s_edge') is not None:
+            m['s_edge'] = max(0.0, m['s_edge'] - shift)
+        kept.append(m)
+    out['maneuvers'] = kept
+    return out
+
