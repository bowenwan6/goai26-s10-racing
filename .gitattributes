* text=auto
*.sh text eol=lf
*.py text eol=lf
policy/gate16/front_tuck_command_profiles.json text eol=lf

# Preserve byte-for-byte handoff manifests and deployed backup evidence.
artifacts/data/deliverables/S10_v3_Map_MuJoCo_20260916/** -text
artifacts/reports/academic_assets/** -text
artifacts/evidence/backups/s10-native-nav/** -text
artifacts/evidence/runs/native-control-handoff-20260917/** -text
artifacts/evidence/runs/native-navigation-audit-20260917/** -text
artifacts/evidence/runs/native-start-b-implementation-20260917/** -text
artifacts/evidence/runs/ros1-gateway-20260918/** -text

# Field deliverables: keep large point clouds and shareable assets out of Git packs.
artifacts/data/deliverables/**/*.pcd filter=lfs diff=lfs merge=lfs -text
artifacts/data/deliverables/*.zip filter=lfs diff=lfs merge=lfs -text
artifacts/data/deliverables/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
artifacts/data/waypoint-photos-20260914/**/*.heic filter=lfs diff=lfs merge=lfs -text
artifacts/data/waypoint-photos-20260914/**/*.HEIC filter=lfs diff=lfs merge=lfs -text
artifacts/data/waypoint-photos-20260914/**/*.jpg filter=lfs diff=lfs merge=lfs -text
artifacts/data/waypoint-photos-20260914/**/*.JPG filter=lfs diff=lfs merge=lfs -text

# README and documentation media are PLAIN GIT, never LFS: a public README render
# would otherwise spend LFS bandwidth on every view and break every image once the
# quota is reached. Budget enforced in CI: 1.2 MB per file, 3.5 MB for docs/media.
docs/media/** -filter -diff -merge text=auto
