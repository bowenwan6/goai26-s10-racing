[Unit]
Description=RoboSense dual RS-LiDAR-AIRY ROS 2 driver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=AGX_USER
WorkingDirectory=REPOSITORY_ROOT
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=REPOSITORY_ROOT/src/dual_airy_merger/config/fastdds_ethernet.xml
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source REPOSITORY_ROOT/install/setup.bash && exec ros2 run rslidar_sdk rslidar_sdk_node --ros-args -p config_path:=REPOSITORY_ROOT/src/dual_airy_merger/config/airy_dual.yaml'
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=5
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
