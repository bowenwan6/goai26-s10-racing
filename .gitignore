# ROS 2 / colcon
build/
install/
log/

# Upstream contest material (cloned by scripts/setup_upstream.sh, not vendored)
upstream/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-win/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Trained artifacts (use Git LFS if these must be tracked)
*.pt
*.pth
*.ckpt
runs/
outputs/
wandb/

# Evaluation output
results/
*.mp4
*.log

# Share the S10 review/reconstruction tools and small results.
# Each included directory excludes its raw recordings and generated caches.
# Other local snapshots and task outputs remain private/local by default.
/artifacts/*
!/artifacts/s10-expert-analysis/
!/artifacts/s10-recording-review-20260909/
!/artifacts/s10-ledge-match-20260909/
!/artifacts/s10-ledge-batch-20260910/
!/artifacts/native-control-handoff-20260917/
!/artifacts/native-navigation-audit-20260917/
!/artifacts/native-start-b-implementation-20260917/
!/artifacts/ros1-gateway-20260918/

# ros1_gateway/nav/s10_auto_nav is generated from src/s10_auto_nav by
# ros1_gateway/nav/sync_auto_nav.sh at the commit recorded in ros1_gateway/nav/COMMIT.
/ros1_gateway/nav/s10_auto_nav/

# ros1_gateway/vendor/agx_only holds an unmodified upstream snapshot staged for the AGX
# (ros1_bridge at ros2/ros1_bridge@611755f); fetch it from upstream instead.
/ros1_gateway/vendor/agx_only/

# Raw investigation dump: quotes a vendor default password in its review text.
/ros1_gateway/docs/NAV_TEST_PLAN_20260920.raw.json
/tmp/
/.playwright-cli/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Runtime artefacts
MUJOCO_LOG.TXT
.race.log

# Keep the selected field handoff and its historical evidence reproducible.
!deliverables/**/*.mp4
!real_transfer/results/
!real_transfer/results/**
!tools/s10_mapping_web/qa/native-nav-evidence/*.log

# Full raw recordings and the multi-GB LiDAR/IMU archive stay in the local workspace.
/recordings/**/raw_bag/*.mcap
/deliverables/S10_048_LiDAR_IMU_*.zip
/academic_assets/*.aux
